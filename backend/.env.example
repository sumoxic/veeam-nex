# ---------------------------------------------------------------------------
# 平台配置模板。复制为 .env 后填入真实值；.env 权限必须为 600，禁止提交到版本库。
# ---------------------------------------------------------------------------

# 应用
APP_NAME=Veeam Inspection Platform
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_RETENTION_DAYS=30

# MySQL —— 只允许使用 veeam_inspection 库
DB_HOST=10.0.54.101
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=veeam_inspection
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# 对外服务端口
API_HOST=0.0.0.0
API_PORT=18000

# 密钥 —— 用 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" 生成
# 丢失此密钥将无法解密已存储的 VBR / SMTP 口令，请另存密码管理器
SECRET_KEY=
# 可选的旧密钥，逗号分隔，用于轮换期间解密历史数据
PREVIOUS_SECRET_KEYS=

# JWT
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 调度器
SCHEDULER_ENABLED=true
DEFAULT_TIMEZONE=Asia/Shanghai

# 巡检默认阈值
DEFAULT_MAX_BACKUP_AGE_HOURS=48
DEFAULT_MIN_FREE_PERCENT=20
DEFAULT_MIN_FREE_GB=20

# 数据保留
INSPECTION_RETENTION_DAYS=90
